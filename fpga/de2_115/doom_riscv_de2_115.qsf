# doom_riscv_de2_115.qsf
#
# Hand-written to match Quartus Settings File format -- NOT generated by
# actually running Quartus (explicitly out of this project's scope, see
# docs/fpga_handoff.md). The human team should open this project in
# Quartus and let it rewrite/normalize this file on first save; treat
# everything here as a reviewed starting point, not a finished,
# Quartus-blessed pin-planner/fitter state.
#
# Device part number: EP4CE115F29C7 is the commonly shipped Terasic
# DE2-115 configuration (Cyclone IV E, F29 package, C7 speed grade,
# commercial grade). The manual block text read in M0
# (docs/board_resource_selection.md) confirms "EP4CE115F29" but does NOT
# state a speed-grade digit. C7 is NOT independently confirmed against
# this specific board's physical marking -- flagged in
# docs/known_limitations.md. Human team: verify against the physical
# device marking or System Builder output before relying on this for
# timing closure.

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY de2_115_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name LAST_QUARTUS_VERSION "N/A -- not generated by Quartus"

# ---- Synthesizable RTL sources (rtl/ only -- sim/models/* are
# simulation-only behavioral models and must NOT be added to this list) ----
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/regfile.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/mul_div.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/cpu_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/peripherals/key_sw_gpio.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/peripherals/timer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/peripherals/vga.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/peripherals/sd_spi.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/peripherals/framebuffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/sdram_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/bus/soc_bus.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/board/de2_115_top.sv

set_global_assignment -name SDC_FILE doom_riscv_de2_115.sdc

# ---- Pin and I/O standard assignments ----
# Generated from docs/pin_assignments.csv (the audited source of truth --
# scripts/pin_audit.py confirms 0 errors across all 26 signals/132 pins
# against rtl/board/de2_115_top.sv's actual port list as of this file's
# writing). Re-run that script and regenerate this block if either file
# changes.
#
# KEY[0:3] and SW[0:17]: the manual table marks these "Depending on JP7"
# rather than a fixed voltage (docs/board_resource_selection.md,
# docs/known_limitations.md). NO IO_STANDARD is assigned below for these
# two buses -- assigning one here would be guessing a value that could be
# electrically wrong. Human team: read the physical JP7 jumper position
# on the board, then add the matching set_instance_assignment IO_STANDARD
# lines (2.5-V LVTTL or 3.3-V LVTTL) for KEY and SW before compiling.
set_location_assignment PIN_Y2 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_location_assignment PIN_M23 -to KEY[0]
# KEY[0]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_M21 -to KEY[1]
# KEY[1]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_N21 -to KEY[2]
# KEY[2]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_R24 -to KEY[3]
# KEY[3]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_AB28 -to SW[0]
# SW[0]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_AC28 -to SW[1]
# SW[1]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_AC27 -to SW[2]
# SW[2]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_AD27 -to SW[3]
# SW[3]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_AB27 -to SW[4]
# SW[4]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_AC26 -to SW[5]
# SW[5]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_AD26 -to SW[6]
# SW[6]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
set_location_assignment PIN_AB26 -to SW[7]
# SW[7]: IO_STANDARD depends on Depending on JP7 -- BLOCKED, needs human-confirmed jumper reading (see docs/known_limitations.md)
